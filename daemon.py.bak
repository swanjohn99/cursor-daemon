def get_operations():
    return [
        ("display_projects", "List projects"),
        ("select_project_1", "Select project 1"),
        ("select_project_2", "Select project 2"),
        ("select_project_3", "Select project 3"),
        ("select_project_4", "Select project 4"),
        ("select_project_5", "Select project 5"),
        ("select_project_6", "Select project 6"),
        ("select_project_7", "Select project 7"),
        ("select_project_8", "Select project 8"),
        ("select_project_9", "Select project 9"),
        ("select_project_10", "Select project 10"),
        ("select_project_11", "Select project 11"),
        ("select_project_12", "Select project 12"),
        ("select_project_13", "Select project 13"),
        ("mode_agent", "Mode: agent"),
        ("mode_plan", "Mode: plan"),
        ("mode_ask", "Mode: ask"),
        ("mode_shell", "Mode: shell"),
        ("mode_plan_on", "Plan on (shortcut)"),
        ("mode_plan_off", "Plan off (shortcut)"),
        ("display_status", "Show status"),
        ("display_help", "Show help"),
        ("display_lock", "Show lock"),
        ("force_lock", "Force lock override"),
        ("cursor_prompt", "Pass to Cursor Agent"),
    ]

# ─── Web handlers ───────────────────────────────────────────────────
async def web_ui(request):
    from aiohttp import web
    state = load_state()
    projects = sorted([d.name for d in WORK_DIR.iterdir() if d.is_dir() and not d.name.startswith(".")])
    proj_opts_tmpl = "\n".join(f'<option value=\"{p}\">{p}</option>' for p in projects)
    ops = get_operations()
    op_options = "\n".join(f'<option value=\"{op}\">{op}</option>' for op, _ in ops)
    
    cards = []
    for token, bot in state.get("bots", {}).items():
        name = html.escape(bot.get("name", "?"))
        proj = html.escape(bot.get("project", "—"))
        mappings = bot.get("mappings", {})
        map_rows = ""
        for cmd, op in sorted(mappings.items()):
                        sel = op_options.replace('value="' + op + '"', 'value="' + op + '" selected')
            map_rows += f'<tr><td><input name="cmd_{html.escape(cmd)}" value="{html.escape(cmd)}"></td><td><select name="op_{html.escape(cmd)}">{sel}</select></td><td><button class="danger small" formmethod="POST" formaction="/delete_mapping" name="cmd" value="{html.escape(cmd)}">✕</button></td></tr>'
        card = BOT_CARD.format(
            name=name, token=html.escape(token), project=proj,
            proj_opts=proj_opts_tmpl.replace(f'value=\"{proj}\"', f'value=\"{proj}\" selected') if proj != "—" else proj_opts_tmpl,
            map_count=len(mappings), mapping_rows=map_rows, op_options=op_options
        )
        cards.append(card)
    
    logs = state.get("logs", [])[-40:]
    log_html = ""
    for entry in reversed(logs):
        cls = "log-error" if entry.get("level") == "error" else ""
        t = entry.get("time", "")[11:19]
        log_html += f'<div class=\"log-entry {cls}\">{t} {html.escape(entry.get(\"msg\", \"\"))}</div>\n'
    
    html_content = HTML.format(
        project_options=proj_opts_tmpl,
        bot_cards="\n".join(cards) or "<p style='color:#888'>No bots added.</p>",
        log_entries=log_html or "<p style='color:#888'>No logs yet.</p>"
    )
    return web.Response(text=html_content, content_type="text/html")

async def web_add(request):
    from aiohttp import web
    data = await request.post()
    name = (data.get("name") or "").strip()
    token = (data.get("token") or "").strip()
    project = (data.get("project") or "").strip()
    if not name or not token:
        return web.Response(text="Name and token required", status=400)
    state = load_state()
    state["bots"][token] = {"name": name, "project": project, "last_command": "", "mappings": dict(DEFAULT_MAPPINGS)}
    save_state(state)
    log(state, f"Bot added: {name}")
    raise web.HTTPFound("/")

async def web_remove(request):
    from aiohttp import web
    data = await request.post()
    token = (data.get("token") or "").strip()
    state = load_state()
    if token in state.get("bots", {}):
        name = state["bots"][token]["name"]
        del state["bots"][token]
        save_state(state)
        log(state, f"Bot removed: {name}")
    raise web.HTTPFound("/")

async def web_assign(request):
    from aiohttp import web
    data = await request.post()
    token = (data.get("token") or "").strip()
    project = (data.get("project") or "").strip()
    state = load_state()
    if token in state.get("bots", {}):
        state["bots"][token]["project"] = project
        save_state(state)
    raise web.HTTPFound("/")

async def web_save_mappings(request):
    from aiohttp import web
    data = await request.post()
    token = (data.get("token") or "").strip()
    action = data.get("action", "save")
    state = load_state()
    if token not in state.get("bots", {}):
        raise web.HTTPFound("/")
    bot = state["bots"][token]
    mappings = bot.get("mappings", {})
    
    if action == "add":
        new_cmd = (data.get("new_cmd") or "").strip().lower()
        new_op = (data.get("new_op") or "").strip()
        if new_cmd and new_op:
            mappings[new_cmd] = new_op
            log(state, f"Mapped: '{new_cmd}' → {new_op}")
    elif action == "save":
        new_mappings = {}
        for key in data:
            if key.startswith("cmd_") and data[key].strip():
                cmd_name = key[4:]
                op_key = f"op_{cmd_name}"
                op_val = data.get(op_key, "").strip()
                if op_val:
                    new_mappings[cmd_name] = op_val
        if new_mappings:
            mappings = new_mappings
            log(state, "Mappings saved")
    
    bot["mappings"] = mappings
    save_state(state)
    raise web.HTTPFound("/")

async def web_delete_mapping(request):
    from aiohttp import web
    data = await request.post()
    token = (data.get("token") or "").strip()
    cmd = (data.get("cmd") or "").strip().lower()
    state = load_state()
    if token in state.get("bots", {}) and cmd in state["bots"][token].get("mappings", {}):
        del state["bots"][token]["mappings"][cmd]
        save_state(state)
        log(state, f"Mapping deleted: '{cmd}'")
    raise web.HTTPFound("/")

# ─── Telegram ───────────────────────────────────────────────────────
async def send_telegram(token, chat_id, text):
    import aiohttp
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    async with aiohttp.ClientSession() as session:
        try:
            async with session.post(url, json={"chat_id": chat_id, "text": text[:4096]}, timeout=aiohttp.ClientTimeout(total=10)) as resp:
                return await resp.json()
        except Exception as e:
            print(f"Telegram error: {e}")

async def handle_message(token, bot_name, text, chat_id, state):
    bot = bot_state(state, token)
    
    # Try dispatch
    result = dispatch(bot, text)
    
    if result is not None:
        bot["last_command"] = text
        save_state(state)
        proj = bot.get("project", "—")
        log(state, f"[{bot_name}:{proj}] ↦ {text[:40]}")
        await send_telegram(token, chat_id, result)
    else:
        log(state, f"[{bot_name}] ✗ Unknown: {text[:40]}")
        await send_telegram(token, chat_id, f"❌ Unknown command: {text}\n\nType 'help' for available commands.")

async def poll_bot(token, state):
    import aiohttp
    offset = 0
    url = f"https://api.telegram.org/bot{token}/getUpdates"
    bot_info = state["bots"].get(token, {})
    bot_name = bot_info.get("name", "unknown")
    while True:
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(url, params={"offset": offset, "timeout": 30, "allowed_updates": ["message"]}, timeout=aiohttp.ClientTimeout(total=35)) as resp:
                    data = await resp.json()
            if data.get("ok"):
                for update in data["result"]:
                    offset = update["update_id"] + 1
                    msg = update.get("message", {})
                    text = msg.get("text", "")
                    chat_id = msg.get("chat", {}).get("id")
                    if text and chat_id:
                        await handle_message(token, bot_name, text, chat_id, state)
        except asyncio.CancelledError:
            break
        except Exception as e:
            print(f"Poll error {bot_name}: {e}")
            await asyncio.sleep(5)

# ─── Main ───────────────────────────────────────────────────────────
async def main():
    from aiohttp import web
    state = load_state()
    log(state, "Daemon v2 starting...")
    
    app = web.Application()
    app.router.add_get("/", web_ui)
    app.router.add_post("/add", web_add)
    app.router.add_post("/remove", web_remove)
    app.router.add_post("/assign", web_assign)
    app.router.add_post("/save_mappings", web_save_mappings)
    app.router.add_post("/delete_mapping", web_delete_mapping)
    
    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, HOST, PORT)
    await site.start()
    log(state, f"Web UI: http://{HOST}:{PORT}")
    
    tasks = []
    for token in state.get("bots", {}):
        tasks.append(asyncio.create_task(poll_bot(token, state)))
    log(state, f"Polling {len(tasks)} bot(s)")
    
    try:
        await asyncio.Event().wait()
    except KeyboardInterrupt:
        log(state, "Shutting down...")
    finally:
        for t in tasks:
            t.cancel()
        await asyncio.gather(*tasks, return_exceptions=True)
        await runner.cleanup()

if __name__ == "__main__":
    asyncio.run(main())