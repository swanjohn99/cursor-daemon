#!/usr/bin/env python3
"""
Cursor Daemon v2 — Named operations, web-mapped commands, zero-token relay.
"""
import asyncio, json, os, subprocess, signal, html, shlex
from pathlib import Path
from datetime import datetime, timezone

# ─── Config ─────────────────────────────────────────────────────────
PORT = 9000
HOST = "0.0.0.0"
STATE_FILE = Path("/home/ubuntu/.cursor-daemon/state.json")
WORK_DIR = Path("/home/ubuntu/work")
CLI = Path("/home/ubuntu/.local/bin/agent")

# ─── Default command mappings ──────────────────────────────────────
DEFAULT_MAPPINGS = {}
for i in range(1, 14):
    DEFAULT_MAPPINGS[str(i)] = f"select_project_{i}"
    DEFAULT_MAPPINGS[f"switch to {i}"] = f"select_project_{i}"
    DEFAULT_MAPPINGS[f"go to {i}"] = f"select_project_{i}"
    DEFAULT_MAPPINGS[f"select {i}"] = f"select_project_{i}"
    DEFAULT_MAPPINGS[f"project {i}"] = f"select_project_{i}"

DEFAULT_MAPPINGS.update({
    "projects": "display_projects", "back": "display_projects",
    "go back": "display_projects", "menu": "display_projects",
    "show projects": "display_projects", "list projects": "display_projects",
    "status": "display_status", "show status": "display_status",
    "current project": "display_status", "what project": "display_status",
    "help": "display_help", "show help": "display_help",
    "lock": "display_lock", "show lock": "display_lock",
    "force": "force_lock", "force lock": "force_lock",
    "plan on": "mode_plan_on", "plan off": "mode_plan_off",
    "turn on plan": "mode_plan_on", "turn off plan": "mode_plan_off",
    "enable plan": "mode_plan_on", "disable plan": "mode_plan_off",
    "mode agent": "mode_agent", "mode plan": "mode_plan",
    "mode ask": "mode_ask", "mode shell": "mode_shell",
    "agent mode": "mode_agent", "plan mode": "mode_plan",
    "ask mode": "mode_ask", "shell mode": "mode_shell",
})

# ─── State ──────────────────────────────────────────────────────────
def load_state():
    if STATE_FILE.exists():
        with open(STATE_FILE) as f:
            s = json.load(f)
    else:
        s = {}
    s.setdefault("bots", {})
    s.setdefault("logs", [])
    # Initialize mappings if missing
    for bot_token in s["bots"]:
        s["bots"][bot_token].setdefault("mappings", dict(DEFAULT_MAPPINGS))
    return s

def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2, default=str)

def log(state, msg, level="info"):
    entry = {"time": datetime.now(timezone.utc).isoformat(), "msg": msg, "level": level}
    state.setdefault("logs", []).append(entry)
    if len(state["logs"]) > 200:
        state["logs"] = state["logs"][-200:]
    print(f"[{entry['time']}] [{level}] {msg}")

# ─── Per-bot state (stored per-bot in state.json) ──────────────────
def bot_state(state, token):
    bot = state["bots"].setdefault(token, {})
    bot.setdefault("project", "")
    bot.setdefault("current_mode", "agent")
    bot.setdefault("current_model", "")
    bot.setdefault("last_command", "")
    bot.setdefault("mappings", dict(DEFAULT_MAPPINGS))
    return bot

# ─── Named operations ───────────────────────────────────────────────
def op_display_projects(bs):
    projects = sorted([d.name for d in WORK_DIR.iterdir() if d.is_dir() and not d.name.startswith(".")])
    if not projects:
        return "No projects found."
    lines = ["Select a project:", ""]
    for i, p in enumerate(projects, 1):
        lines.append(f"{i}. {p}")
    lines.append("")
    lines.append(f"Reply with a number (1-{len(projects)}) to select.")
    return "\n".join(lines)

def op_select_project(bs, num):
    projects = sorted([d.name for d in WORK_DIR.iterdir() if d.is_dir() and not d.name.startswith(".")])
    if num < 1 or num > len(projects):
        return f"Invalid. Pick 1-{len(projects)}."
    name = projects[num - 1]
    proj_dir = WORK_DIR / name
    # Lock
    lock_dir = proj_dir / ".agent-lock"
    bot_name = bs.get("name", "daemon")
    if lock_dir.exists():
        owner_file = lock_dir / "owner"
        if owner_file.exists():
            owner = owner_file.read_text().strip().split("=", 1)[-1]
            if owner != bot_name:
                return f"LOCKED by {owner}. Use 'force' to override."
    # Acquire lock
    lock_dir.mkdir(exist_ok=True)
    (lock_dir / "owner").write_text(f"agent_id={bot_name}\nlocked_at={datetime.now(timezone.utc).isoformat()}")
    bs["project"] = name
    return f"Now in: {name}\n\nAll messages go to Cursor Agent. Type 'projects' to switch."

def op_mode(bs, mode):
    bs["current_mode"] = mode
    return f"Mode: {mode}"

def op_display_status(bs):
    proj = bs.get("project", "none")
    mode = bs.get("current_mode", "agent")
    model = bs.get("current_model", "(default)")
    return f"Project: {proj}\nPath: {WORK_DIR / proj if proj != 'none' else '—'}\nModel: {model}\nMode: {mode}"

def op_display_help(bs):
    return """AVAILABLE COMMANDS:

PROJECTS:
  N (1-13)              — select project N
  projects / back       — show project list

MODE:
  mode agent / plan / ask / shell — switch mode
  plan on / turn on plan          — plan mode
  plan off / turn off plan        — back to agent

SETTINGS:
  model <name>          — set Cursor model
  status                — current state

LOCKS:
  lock                  — show lock status
  force                 — override stale lock

  help                  — show this message"""

def op_display_lock(bs):
    proj = bs.get("project", "")
    if not proj:
        return "No project selected."
    lock_dir = WORK_DIR / proj / ".agent-lock"
    owner_file = lock_dir / "owner"
    if owner_file.exists():
        owner = owner_file.read_text().strip().split("=", 1)[-1]
        return f"Locked by: {owner}"
    return "Not locked."

def op_force_lock(bs):
    proj = bs.get("project", "")
    if not proj:
        return "No project selected."
    lock_dir = WORK_DIR / proj / ".agent-lock"
    import shutil
    if lock_dir.exists():
        shutil.rmtree(lock_dir)
    lock_dir.mkdir()
    bot_name = bs.get("name", "daemon")
    (lock_dir / "owner").write_text(f"agent_id={bot_name}\nlocked_at={datetime.now(timezone.utc).isoformat()}")
    return "Lock acquired (forced)."

def op_cursor_prompt(bs, text):
    proj = bs.get("project", "")
    if not proj:
        return "No project selected. Pick a number first."
    proj_dir = WORK_DIR / proj
    if not proj_dir.is_dir():
        return f"Project directory not found: {proj_dir}"
    
    mode = bs.get("current_mode", "agent")
    model = bs.get("current_model", "")
    
    # Build agent command
    cmd = [str(CLI), "-p"]
    if mode == "plan":
        cmd.append("--plan")
    elif mode == "ask":
        cmd.extend(["--mode", "ask"])
    elif mode == "shell":
        # Shell mode — execute directly
        try:
            result = subprocess.run(
                ["bash", "-c", text],
                capture_output=True, text=True, timeout=30,
                cwd=str(proj_dir), env={**os.environ, "HOME": "/home/ubuntu"}
            )
            return result.stdout.strip() or result.stderr.strip() or "(empty)"
        except subprocess.TimeoutExpired:
            return "Command timed out (30s)."
    
    if model:
        cmd.extend(["--model", model])
    cmd.append(text)
    
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=120,
            cwd=str(proj_dir), env={**os.environ, "HOME": "/home/ubuntu"}
        )
        output = result.stdout.strip() or result.stderr.strip()
        return output or "(empty response from Cursor Agent)"
    except subprocess.TimeoutExpired:
        return "Cursor Agent timed out (120s)."
    except Exception as e:
        return f"Error: {e}"

# ─── Command dispatch ───────────────────────────────────────────────
def dispatch(bs, text):
    """Look up text in bot's mappings, execute the named operation."""
    mappings = bs.get("mappings", DEFAULT_MAPPINGS)
    lower = text.lower().strip()
    
    # Exact lookup
    op = mappings.get(lower)
    if not op:
        # Try case-insensitive
        for k, v in mappings.items():
            if k.lower() == lower:
                op = v
                break
    
    if not op:
        return None  # Unknown
    
    # Model command: "model grok-4.5-high"
    if lower.startswith("model "):
        model_name = text.split(" ", 1)[1].strip() if " " in text else ""
        if model_name:
            bs["current_model"] = model_name
            return f"Model: {model_name}"
        return "Usage: model <name>"
    
    # Dispatch
    if op == "display_projects":
        return op_display_projects(bs)
    elif op.startswith("select_project_"):
        num = int(op.split("_")[-1])
        return op_select_project(bs, num)
    elif op == "mode_agent":
        return op_mode(bs, "agent")
    elif op == "mode_plan":
        return op_mode(bs, "plan")
    elif op == "mode_ask":
        return op_mode(bs, "ask")
    elif op == "mode_shell":
        return op_mode(bs, "shell")
    elif op == "mode_plan_on":
        return op_mode(bs, "plan")
    elif op == "mode_plan_off":
        return op_mode(bs, "agent")
    elif op == "display_status":
        return op_display_status(bs)
    elif op == "display_help":
        return op_display_help(bs)
    elif op == "display_lock":
        return op_display_lock(bs)
    elif op == "force_lock":
        return op_force_lock(bs)
    elif op == "cursor_prompt":
        return op_cursor_prompt(bs, text)
    
    return f"Unknown operation: {op}"

