BOT_CARD = """<div class="card">
<h3>🤖 {name} <span class="badge badge-on">● {project}</span></h3>
<div class="row" style="margin-bottom:8px">
<form method="POST" action="/assign" style="display:inline">
<input type="hidden" name="token" value="{token}">
<select name="project" onchange="this.form.submit()">
<option value="">— Unassigned —</option>
{proj_opts}
</select>
</form>
<form method="POST" action="/remove" style="display:inline" onsubmit="return confirm('Delete {name}?')">
<input type="hidden" name="token" value="{token}">
<button class="danger">✕</button>
</form>
</div>
<details>
<summary style="cursor:pointer;color:#888;font-size:12px">📖 Mappings ({map_count}) — click to edit</summary>
<form method="POST" action="/save_mappings" style="margin-top:8px">
